# ==========================================
# .gitignore — Proyecto Monitor de Precios
# ==========================================

# ---- Python / Django ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
*.sqlite3
*.db
*.log
local_settings.py
staticfiles/
media/

# ---- Entornos virtuales ----
venv/
env/
.venv/

# ---- Celery ----
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid

# ---- Docker / Docker Compose ----
docker-compose.override.yml

# Datos persistidos de la base de datos (volúmenes de Docker)
mysql_data/
postgres_data/

# ---- Variables de entorno y secretos ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---- Node / Frontend ----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/.vite/
*.local

# ---- Archivos de sistema ----
.DS_Store
Thumbs.db
desktop.ini
.Spotlight-V100
.Trashes

# ---- IDEs y editores ----
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp
*~
.project
.classpath
.settings/

# ---- Playwright / Browsers ----
/ms-playwright/
playwright-browsers/

# ---- Archivos temporales sueltos en raíz ----
void
curl
setIsEditing*
setNewTargetPrice*

# ---- Cobertura de tests ----
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.tox/

# ---- Mypy / type checkers ----
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
